{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "JavaScript: Check current file syntax",
      "type": "process",
      "command": "node",
      "args": [
        "--check",
        "${file}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workspace: Validate VS Code JSON configuration",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}\\scripts\\validate-workspace-config.js"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
